{
	"version": 1,
	"base_image": "codeocean/mambaforge3:24.5.0-0-python3.12.4-ubuntu22.04",
	"args": [
		"AWS_ACCESS_KEY_ID",
		"AWS_DEFAULT_REGION",
		"AWS_SECRET_ACCESS_KEY"
	],
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true
	},
	"installers": {
		"apt": {
			"packages": [
				{
					"name": "vim",
					"version": "2:8.2.3995-1ubuntu2.24"
				}
			],
			"install_software_properties_common": true
		},
		"pip": {
			"packages": [
				{
					"name": "git+https://github.com/AllenNeuralDynamics/aind-pophys-converter#egg=aind-pophys-converter",
					"version": "84f6a09cd1f37eff79109f9bb07a553150404db2"
				},
				{
					"name": "pydantic-settings",
					"version": "2.8.1"
				}
			],
			"options": {},
			"pre_install_options": {}
		},
		"vscode": {
			"packages": [
				{
					"name": "REditorSupport.R"
				},
				{
					"name": "continue.continue"
				},
				{
					"name": "ms-python.python"
				},
				{
					"name": "ms-toolsai.jupyter"
				},
				{
					"name": "reageyao.bioSyntax"
				},
				{
					"name": "saoudrizwan.claude-dev"
				}
			],
			"version": "4.95.3"
		}
	}
}