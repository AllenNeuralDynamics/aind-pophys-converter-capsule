{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": ["--input_dir", "data/", "--output_dir", "results/", "temp_dir", "scratch/", "--debug", "false"]
        }
    ]
}